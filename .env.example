# Versões oficiais dos motores da Receita Federal (tags do GitHub).
# Trocar a versão aqui e rodar `docker compose build` é tudo o que uma
# atualização da Receita exige (ver docs/adr/ADR003).
VERSAO_REGIME_REGULAR=1.7.2
VERSAO_SIMPLES_NACIONAL=1.0.2
VERSAO_GERADOR_DANFSE=1.0.0

# Portas publicadas no servidor (cada motor ganha a sua; ver ADR003).
PORTA_REGIME_REGULAR=8081
PORTA_SIMPLES_NACIONAL=8082
PORTA_GERADOR_DANFSE=8083
